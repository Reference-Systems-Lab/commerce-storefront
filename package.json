{
  "name": "commerce-storefront",
  "private": true,
  "description": "The commerce platform's storefront: marketing, discovery and buying",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "nuxt:prepare": "nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "npm run nuxt:prepare && eslint . && prettier --check .",
    "typecheck": "npm run nuxt:prepare && vue-tsc -b --noEmit",
    "test": "npm run nuxt:prepare && vitest run --coverage",
    "knip": "npm run nuxt:prepare && knip"
  },
  "dependencies": {
    "@reference-systems-lab/commerce-api": "^0.1.0",
    "@reference-systems-lab/tokens": "^0.1.0",
    "nuxt": "4.5.2",
    "nuxt-security": "2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@reference-systems-lab/eslint-config": "^0.1.0",
    "@reference-systems-lab/prettier-config": "^0.1.0",
    "@reference-systems-lab/tsconfig": "^0.1.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "overrides": {
    "simple-git": "4.0.2"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  },
  "prettier": "@reference-systems-lab/prettier-config"
}

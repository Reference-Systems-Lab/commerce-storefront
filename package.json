{
  "name": "commerce-storefront",
  "private": true,
  "description": "The commerce platform's storefront: marketing, discovery and buying",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "nuxt:prepare": "nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "npm run nuxt:prepare && eslint . && prettier --check .",
    "typecheck": "npm run nuxt:prepare && vue-tsc -b --noEmit",
    "test": "npm run nuxt:prepare && vitest run --coverage",
    "knip": "npm run nuxt:prepare && knip"
  },
  "dependencies": {
    "@reference-systems-lab/commerce-api": "^0.1.0",
    "@reference-systems-lab/tokens": "^0.1.0",
    "h3": "1.15.11",
    "nitropack": "2.13.6",
    "nuxt": "4.6.3",
    "nuxt-security": "2.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@reference-systems-lab/eslint-config": "^0.2.0",
    "@reference-systems-lab/prettier-config": "^0.1.0",
    "@reference-systems-lab/tsconfig": "^0.2.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "simple-git": "4.0.2"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  },
  "prettier": "@reference-systems-lab/prettier-config"
}

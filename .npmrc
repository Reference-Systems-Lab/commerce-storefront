# The hardened npm settings every repository uses (commerce ADR 0001, DE-2), plus our scope on
# GitHub Packages. The token lives in ~/.npmrc or a BuildKit secret, never here.
strict-allow-scripts=true
min-release-age=7
allow-git=none
allow-remote=none
engine-strict=true
@reference-systems-lab:registry=https://npm.pkg.github.com
min-release-age-exclude[]=@reference-systems-lab/*
# Temporary (#2 D-30): node-forge 1.4.2, which fixes high advisories including GHSA-86w9-cpqp-85rv,
# installed before its 7-day window by @ABilenduke's decision. scripts/check-repo.mjs allows this only
# until 1.4.2 is 7 days old, then make lint fails until the line is removed.
min-release-age-exclude[]=node-forge

# The hardened npm settings every repository uses (commerce ADR 0001, DE-2), plus our scope on
# GitHub Packages. The token lives in ~/.npmrc or a BuildKit secret, never here.
strict-allow-scripts=true
min-release-age=7
allow-git=none
allow-remote=none
engine-strict=true
@reference-systems-lab:registry=https://npm.pkg.github.com
min-release-age-exclude[]=@reference-systems-lab/*
# Temporary (#2 D-27): Nuxt 4.6.0 and the packages it needs, installed before their 7-day window by
# @ABilenduke's decision. scripts/check-repo.mjs allows each only until its installed version is 7 days
# old, then make lint fails until the line is removed.
min-release-age-exclude[]=nuxt
min-release-age-exclude[]=@nuxt/kit
min-release-age-exclude[]=@nuxt/schema
min-release-age-exclude[]=@nuxt/nitro-server
min-release-age-exclude[]=@nuxt/vite-builder
min-release-age-exclude[]=@nuxt/vite-server
min-release-age-exclude[]=@nuxt/cli
min-release-age-exclude[]=my-bad
min-release-age-exclude[]=package-manager-detector

# The hardened npm settings every repository uses (commerce ADR 0001, DE-2), plus our scope on
# GitHub Packages. The token lives in ~/.npmrc or a BuildKit secret, never here.
strict-allow-scripts=true
min-release-age=7
allow-git=none
allow-remote=none
engine-strict=true
@reference-systems-lab:registry=https://npm.pkg.github.com
min-release-age-exclude[]=@reference-systems-lab/*
